# nasaeemlibya.ly — static company site (built from company-site/ in the repo)
Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # https always; AutoSSL in cPanel covers the domain
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # /en  ->  /en/
  RewriteRule ^en$ /en/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # the pages themselves are never cached, so a new build shows at once
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # css/js carry a hash in their URL; fonts and images rarely change
  <FilesMatch "\.(css|js|woff2|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
